# 复制为 .env 后按需修改。不要提交 .env。
# 优先级：命令行/系统环境变量 > .env > 代码默认值（进程里已有的值不会被 .env 覆盖）

# ---- 模型（OpenAI 兼容接口）----
# 直连厂商的 /v1。换成任一家兼容接口只改这三行。
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-3.0-flash
LLM_API_KEY=sk-xxxxxxxx

# 历史默认值是本机中转 http://127.0.0.1:57321/v1。注意那个端口只挂了
# Responses 协议、没有 Chat Completions，填它会一直拿不到结果。
# 本机有系统代理时，访问 127.0.0.1 还会被劫持并返回 502——
# 这个报错看起来像「中转没启动」，极难定位，所以默认不走代理。

# 是否读取系统代理（HTTP_PROXY/NO_PROXY）。默认 0。
# 改接外网 API 且必须经过代理时才设为 1。
LLM_TRUST_ENV=0

# ---- 运行模式 ----
# DEMO=1：使用 demo/ 内置数据，不连真实网站，话术走模板兜底，无需 API key
DEMO=0

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000

# ---- 业务 ----
# 发出多久没回音算「该催了」。四倍于此算「久无回音」。
FOLLOWUP_AFTER_HOURS=18
# 点「知道了」之后安静多久再提。设很大等于永久静音（不建议：提醒会因此失效）。
ALERT_SNOOZE_HOURS=12

# ---- 抓取 ----
# 浏览器调试端口地址。用 --remote-debugging-port=9222 启动的 Edge/Chrome 就是默认值
CRAWL_CDP=http://127.0.0.1:9222
