# 环境与密钥
.env
*.env
!.env.example

# 真实档案（含手机号、邮箱，绝不提交）
data/profile.json

# 数据库与产物
data/*.db
data/*.bak-*
output/
*.docx
*.pdf

# 改代码前的临时备份（*.bak-before-xxx 这类），只是本地保险，不是源码
*.bak-*
*.orig

# 浏览器登录态（绝对不能提交，含 cookie）
browser_profile/
.playwright/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# 前端（若后续引入）
node_modules/
dist/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 抓取产物：本地校准用，随时会重新生成，不进仓库
fixtures/boss/real/

# 工作区记忆目录，属于本地工具链产物，不是项目源码
.workbuddy/
